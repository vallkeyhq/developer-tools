{
  "name": "vallkey",
  "version": "0.8.1",
  "description": "Replace the API keys in your project with ghost keys that only work within your rules.",
  "license": "MIT",
  "author": "Vallkey",
  "bugs": {
    "url": "https://github.com/vallkeyhq/developer-tools/issues"
  },
  "type": "module",
  "bin": {
    "vallkey": "dist/bin/vallkey.js"
  },
  "exports": {
    "./auto": {
      "types": "./dist/src/auto.d.cts",
      "default": "./dist/src/auto.cjs"
    },
    "./session": {
      "types": "./dist/src/session.d.cts",
      "default": "./dist/src/session.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/bin",
    "dist/src"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsx ../scripts/copy-build-assets.mts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && tsx --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "homepage": "https://vallkey.com/docs/",
  "keywords": [
    "api-keys",
    "secrets",
    "security",
    "openai",
    "stripe",
    "anthropic",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vallkeyhq/developer-tools.git",
    "directory": "cli"
  }
}
